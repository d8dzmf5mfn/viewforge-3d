#!/bin/zsh
set -euo pipefail

SCRIPT_DIRECTORY="$(cd -- "$(dirname -- "$0")" && pwd)"
PLUGIN_ROOT="$(cd -- "$SCRIPT_DIRECTORY/.." && pwd)"
REPOSITORY_ROOT="$(cd -- "$PLUGIN_ROOT/../.." && pwd)"
export VIEWFORGE_PLUGIN_ROOT="$PLUGIN_ROOT"

APP_CANDIDATES=(
  "/Applications/ViewForge Local.app"
  "$HOME/Applications/ViewForge Local.app"
  "$REPOSITORY_ROOT/dist/viewforge-local/ViewForge Local.app"
)

for app in "${APP_CANDIDATES[@]}"; do
  python="$app/Contents/Resources/runtime/bin/python3.11"
  source_root="$app/Contents/Resources/python"
  if [[ -x "$python" && -d "$source_root" ]]; then
    export PYTHONPATH="$source_root"
    export PYTHONNOUSERSITE=1
    export PYTHONDONTWRITEBYTECODE=1
    exec "$python" -m face3d.local_mcp.server "$@"
  fi
done

if [[ -x "$REPOSITORY_ROOT/.venv/bin/python" ]]; then
  export PYTHONPATH="$REPOSITORY_ROOT/src"
  export PYTHONNOUSERSITE=1
  export PYTHONDONTWRITEBYTECODE=1
  exec "$REPOSITORY_ROOT/.venv/bin/python" -m face3d.local_mcp.server "$@"
fi

echo "ViewForge Local runtime not found. Build or install ViewForge Local.app first." >&2
exit 78
